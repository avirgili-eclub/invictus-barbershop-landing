<section id="servicios" class="section-pad services-section">
  <div class="container services-shell">
    <header class="services-head">
      <div class="services-title-group">
        <p class="eyebrow services-eyebrow">El menu</p>
        <h2 class="services-title">Servicios de Autor</h2>
      </div>
      <p class="services-intro">Cada servicio incluye un analisis morfologico previo para adaptar el estilo a tu fisionomia.</p>
    </header>

    <div class="services-grid-wrap">
      <div class="services-grid">
      {
        services.map((service, index) => (
          <article class="service-author-card">
            <div class="service-author-top">
              <span class="service-icon" aria-hidden="true">
                <svg viewBox={serviceIconPaths[index].viewBox} xmlns="http://www.w3.org/2000/svg" focusable="false">
                  <path d={serviceIconPaths[index].path} fill="currentColor" />
                </svg>
              </span>
              <span class="service-duration">{service.duration.toUpperCase()}</span>
            </div>
            <h3>{service.name}</h3>
            <p>{service.description}</p>
            <a href="#agenda" class="service-link">Reservar &rarr;</a>
          </article>
        ))
      }
      </div>
    </div>
  </div>
</section>
