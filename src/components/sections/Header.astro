---
import { navItems } from "../../data/landing";
---

<header class="site-header">
  <div class="container nav-shell">
    <a href="#inicio" class="brand-mark" aria-label="Invictus Barbershop">
      <img
        src="/images/invictus-logo-transparent-fixed.png"
        alt="Invictus"
        width="542"
        height="192"
        loading="eager"
        decoding="async"
      />
    </a>
    <nav class="nav-links" aria-label="Principal">
      {
        navItems.map((item, index) => (
          <a
            href={item.href}
            class={`nav-link ${index === 0 ? "nav-link-active" : ""}`}
            aria-current={index === 0 ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <nav class="mobile-shortcuts" aria-label="Accesos rapidos">
      <a href="#servicios" class="mobile-shortcut-link">Servicios</a>
      <a href="#agenda" class="mobile-shortcut-link">Agenda</a>
    </nav>
    <a class="btn btn-primary nav-cta" href="#agenda">Agendar turno</a>
  </div>
</header>
